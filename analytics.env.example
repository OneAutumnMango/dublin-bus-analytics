# Compose-level settings (read by docker-compose.example.yml; copy to .env or export).
ANALYTICS_PORT=8081             # host port, bound to 127.0.0.1 only
ANALYTICS_POLL_SECONDS=30       # seconds between polls of each tracked route
ANALYTICS_BACKUP_ENABLED=true   # nightly backup on/off (true/false/1/0/yes/no)
ANALYTICS_BACKUP_TIME=03:00     # HH:MM, Europe/Dublin local time
ANALYTICS_BACKUP_KEEP=7         # number of backup tars to keep (>= 1)
ANALYTICS_BACKUP_DIR=/data/backups  # container path; use /backups with the bind mount in the compose file

# App-level settings (read by app/config.py; use these when running without compose, e.g. uvicorn).
# Compose sets BACKUP_* and POLL_SECONDS from the ANALYTICS_* names above.
# SERVER_URL=http://dublin-bus-server:8080  # base URL of dublin-bus-server
# DATA_DIR=/data                  # where meta.db, samples-*.db and backups/ live
# POLL_SECONDS=30
# SERVER_TIMEOUT_SECONDS=45       # read timeout for calls to the server, in seconds
# SERVER_CONCURRENCY=2            # routes fetched at once; lower is gentler on a Raspberry Pi
# PORT=8081                       # parsed into Settings only; the listen port is uvicorn's --port
# BACKUP_ENABLED=true
# BACKUP_TIME=03:00
# BACKUP_KEEP=7
# BACKUP_DIR=/data/backups        # default: <DATA_DIR>/backups
# WEB_DIR=/srv/web                # static UI directory; default: web/ next to app/
